# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-TU_API_KEY_AQUI
# Astra transcribe; Terra identifica códigos y extrae JSON del texto.
OPENAI_MODEL=gpt-6-astra
OPENAI_ID_MODEL=gpt-6.1-terra
OPENAI_TEXT_MODEL=gpt-6.1-terra
OCR_IMAGE_DETAIL=original
ID_IMAGE_DETAIL=original
OCR_REASONING_EFFORT=low
ID_REASONING_EFFORT=none
TEXT_REASONING_EFFORT=low
OCR_MAX_OUTPUT_TOKENS=12000
ID_MAX_OUTPUT_TOKENS=1024
OPENAI_MAX_IN_FLIGHT=8

# ── Rendimiento ────────────────────────────────────────
CONCURRENCY=5
FILE_CONCURRENCY=3
MAX_RETRIES=5
RETRY_DELAY_MS=10000
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_PATCHES=28000
MAX_FILE_SIZE_MB=500
TIMEOUT_PER_PAGE_MS=180000

# ── Carpetas ───────────────────────────────────────────
INPUT_DIR=./input
OUTPUT_DIR=./output
PROCESSED_DIR=./processed
ERROR_DIR=./error

# ── Watcher ────────────────────────────────────────────
WATCH_INTERVAL_MS=2000
MAX_BATCH_SIZE=50

# ── Logging ────────────────────────────────────────────
# LOG_DEBUG=true

# ── Proxy Corporativo (opcional) ──────────────────────
# Descomentar y configurar si estás en red corporativa
# HTTPS_PROXY=http://proxy.empresa.com:8080
# HTTP_PROXY=http://proxy.empresa.com:8080
